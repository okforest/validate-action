{
  "name": "validate-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action that validates Open Knowledge Format (OKF) v0.2 trees with OKForest: annotations on the pull request, a job summary, and a JSON report.",
  "license": "Apache-2.0",
  "author": "Preneur LLC",
  "homepage": "https://github.com/okforest/validate-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okforest/validate-action.git"
  },
  "bugs": "https://github.com/okforest/validate-action/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/pin-d2.mjs && tsdown && node scripts/licenses.mjs",
    "pin": "node scripts/pin-d2.mjs",
    "test": "pnpm pin && vitest run",
    "test:coverage": "pnpm pin && vitest run --coverage",
    "typecheck": "pnpm pin && tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write"
  },
  "dependencies": {
    "@actions/core": "catalog:",
    "@actions/tool-cache": "catalog:",
    "@okforest/okf": "catalog:",
    "@okforest/validate": "catalog:",
    "mermaid": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@d2lang/d2": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  }
}
